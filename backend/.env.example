# Copy to .env and change SECRET_KEY. Leave DATABASE_URL empty for zero-setup SQLite,
# or use PostgreSQL: postgresql+psycopg2://gridwise:gridwise@localhost:5432/gridwise
DATABASE_URL=sqlite:///./gridwise.db
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
# Site local time offset from UTC in minutes (India = 330). Timestamps are stored as site-local time.
TZ_OFFSET_MIN=330
